# photo-stamp-server: the place server. Build from the repository root:
#   docker build -f docker/Dockerfile.server -t photo-stamp-server .

FROM rust:1-slim AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
# The whole workspace has to be there for cargo to resolve it; only the server is built.
COPY assets assets
COPY src src
COPY http http
COPY proto proto
COPY server server
COPY ui ui
RUN cargo build --release --locked -p photo-stamp-server

FROM debian:trixie-slim
# python3 builds the places database (GeoNames + Wikidata) during `import`.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/photo-stamp-server /usr/local/bin/photo-stamp-server
COPY scripts/build-places-db.py /usr/share/photo-stamp/build-places-db.py
RUN mkdir -p /data && chmod 1777 /data
ENV PHOTO_STAMP_SERVER_DATA=/data HOME=/tmp
VOLUME ["/data"]
EXPOSE 8080
ENTRYPOINT ["photo-stamp-server"]
CMD ["serve"]
